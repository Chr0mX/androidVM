{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "required": ["meta", "system", "vendor"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "description", "created"],
      "properties": {
        "id":          { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "description": { "type": "string" },
        "created":     { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "required": [
        "ro.product.manufacturer", "ro.product.model",
        "ro.product.name", "ro.product.device",
        "ro.build.fingerprint", "ro.build.description",
        "ro.build.tags", "ro.build.type"
      ],
      "properties": {
        "ro.product.manufacturer":        { "type": "string" },
        "ro.product.model":               { "type": "string" },
        "ro.product.name":                { "type": "string" },
        "ro.product.device":              { "type": "string" },
        "ro.product.brand":               { "type": "string" },
        "ro.build.fingerprint":           { "type": "string" },
        "ro.build.description":           { "type": "string" },
        "ro.build.tags":                  { "enum": ["release-keys", "dev-keys", "test-keys"] },
        "ro.build.type":                  { "enum": ["user", "userdebug"] },
        "ro.system.build.fingerprint":    { "type": "string" },
        "ro.product.system.manufacturer": { "type": "string" },
        "ro.product.system.model":        { "type": "string" },
        "ro.product.system.name":         { "type": "string" },
        "ro.product.system.device":       { "type": "string" },
        "ro.product.system.brand":        { "type": "string" }
      },
      "additionalProperties": { "type": "string" },
      "not": {
        "anyOf": [
          { "required": ["ro.secure"] },
          { "required": ["ro.debuggable"] },
          { "required": ["ro.boot.hardware"] }
        ]
      }
    },
    "vendor": {
      "type": "object",
      "required": [
        "ro.product.vendor.manufacturer", "ro.product.vendor.model",
        "ro.product.vendor.name", "ro.product.vendor.device",
        "ro.vendor.build.fingerprint"
      ],
      "properties": {
        "ro.product.vendor.manufacturer":  { "type": "string" },
        "ro.product.vendor.model":         { "type": "string" },
        "ro.product.vendor.name":          { "type": "string" },
        "ro.product.vendor.device":        { "type": "string" },
        "ro.product.vendor.brand":         { "type": "string" },
        "ro.vendor.build.fingerprint":     { "type": "string" }
      },
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
