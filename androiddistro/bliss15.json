{
  "name": "BlissOS 15",
  "slug": "bliss15",
  "android_version": 12,
  "arch": "x86_64",
  "base_image": "blissos15-base.qcow2",
  "inject_gapps": false,
  "inject_arm_trans": false,

  "source": {
    "type": "sourceforge_latest",
    "sf_path": "Official/BlissOS15/FOSS/Generic",
    "sf_filter": ".iso"
  },

  "grub": {
    "hwc": "drm",
    "gralloc": "gbm",
    "extra_params": [
      "vt.global_cursor_default=0",
      "quiet"
    ]
  },

  "qemu": {
    "preferred_gpu": "virtio-vga",
    "preferred_display": "gtk,gl=off",
    "audio_device": "ich9-intel-hda"
  },

  "notes": [
    "Pure base image — no GApps, no ARM translation",
    "Android 12 base",
    "HWC=drm + GRALLOC=gbm: standard DRM/GBM path, no virgl required"
  ]
}
