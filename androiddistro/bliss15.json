{
  "name": "BlissOS 15",
  "slug": "bliss15",
  "android_version": 12,
  "arch": "x86_64",
  "base_image": "blissos15-gapps-arm.qcow2",
  "inject_gapps": true,

  "source": {
    "type": "sourceforge_latest",
    "sf_path": "Official/BlissOS15/FOSS/Generic",
    "sf_filter": ".iso"
  },

  "gapps": {
    "url": "https://github.com/MindTheGapps/12.1.0-x86_64/releases/download/MindTheGapps-12.1.0-x86_64-20231025_201056/MindTheGapps-12.1.0-x86_64-20231025_201056.zip"
  },

  "grub": {
    "hwc": "drm_minigbm",
    "gralloc": "minigbm",
    "extra_params": [
      "vt.global_cursor_default=0"
    ]
  },

  "qemu": {
    "preferred_gpu": "virtio-vga-gl",
    "preferred_display": "gtk,gl=on",
    "audio_device": "ich9-intel-hda"
  },

  "notes": [
    "MindTheGapps 12.1.0 x86_64 + ARM translation pre-installed",
    "Android 12 base",
    "Same drm_minigbm + minigbm display stack as BlissOS 14"
  ]
}
