{
  "name": "BlissOS 14",
  "slug": "bliss14",
  "android_version": 11,
  "arch": "x86_64",
  "base_image": "blissos14-base.qcow2",
  "inject_gapps": false,
  "inject_arm_trans": false,

  "source": {
    "type": "sourceforge_latest",
    "sf_path": "Official/BlissOS14/FOSS/Generic",
    "sf_filter": ".iso"
  },

  "qemu": {
    "preferred_gpu": "virtio-vga",
    "preferred_display": "gtk,gl=off",
    "audio_device": "ich9-intel-hda"
  },

  "notes": [
    "Pure base image — no GApps, no ARM translation",
    "HWC=drm + GRALLOC=gbm: standard DRM/GBM path, no virgl required"
  ]
}
