{
  "name": "BlissOS 14",
  "slug": "bliss14",
  "android_version": 11,
  "arch": "x86_64",
  "base_image": "blissos14-base.qcow2",
  "inject_gapps": false,
  "inject_arm_trans": false,

  "source": {
    "type": "sourceforge_latest",
    "sf_path": "Official/BlissOS14/FOSS/Generic",
    "sf_filter": ".iso"
  },

  "grub": {
    "hwc": "drm_minigbm",
    "gralloc": "minigbm",
    "extra_params": [
      "vt.global_cursor_default=0"
    ]
  },

  "qemu": {
    "preferred_gpu": "virtio-vga",
    "preferred_display": "gtk,gl=on",
    "audio_device": "ich9-intel-hda"
  },

  "notes": [
    "Pure base image — no GApps, no ARM translation",
    "drm_minigbm + minigbm: compatible with VNC (no host GL context required)"
  ]
}
