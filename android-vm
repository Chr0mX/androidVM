#!/usr/bin/env bash
# android-vm — unified Android x86 VM manager
#
# Usage: android-vm <subcommand> [args] [--debug]
#
# Subcommands:
#   start        [instance-or-profile] [--vm-profile <name>]
#   stop         [instance-or-profile]
#   status       [instance-or-profile]
#   reset        [instance-or-profile]
#   update
#   doctor
#   profiles
#   virt-manager [device-profile] [--define] [--start] [...]
#   instance     {create|list|start|stop|restart|reset|delete|show} [...]
#   gui          [--port <n>] [--bind <addr>] [--no-open]
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

# ── Colour helpers ────────────────────────────────────────────────────────────
if [ -t 1 ]; then
  RED='\033[0;31m' YEL='\033[0;33m' GRN='\033[0;32m'
  BLU='\033[0;34m' DIM='\033[2m'    NC='\033[0m'
else
  RED='' YEL='' GRN='' BLU='' DIM='' NC=''
fi

log()  { printf "${BLU}[android-vm]${NC} %s\n" "$*"; }
ok()   { printf "${GRN}[  ok  ]${NC} %s\n" "$*"; }
warn() { printf "${YEL}[ warn ]${NC} %s\n" "$*" >&2; }
die()  { printf "${RED}[ FAIL ]${NC} %s\n" "$*" >&2; exit 1; }

command -v jq &>/dev/null || die "jq is required but not found. Install it first."

for _arg in "$@"; do
  [ "$_arg" = "--debug" ] && set -x
done
unset _arg

DEFAULTS_JSON="${ROOT}/config/defaults.json"
SPOOF_JSON="${ROOT}/config/device-spoof.json"

# shellcheck source=scripts/lib/instance.sh
. "${ROOT}/scripts/lib/instance.sh"
# shellcheck source=scripts/lib/alloc-nbd.sh
. "${ROOT}/scripts/lib/alloc-nbd.sh"

cfg_get() {
  local key="$1" fallback="${2:-}"
  jq -r "${key} // \"${fallback}\"" "$DEFAULTS_JSON" 2>/dev/null || echo "$fallback"
}

spoof_get() {
  local key="$1" fallback="${2:-}"
  jq -r "${key} // \"${fallback}\"" "$SPOOF_JSON" 2>/dev/null || echo "$fallback"
}

default_device_profile() {
  local p
  p=$(spoof_get '.default_profile' "")
  [ -z "$p" ] && p=$(cfg_get '.default_device_profile' "pixel6a-bp1a")
  echo "$p"
}

default_vm_profile() { cfg_get '.default_vm_profile' "balanced"; }
default_distro()     { cfg_get '.default_distro'     "bliss14"; }
default_gui_port()   { cfg_get '.gui_port'           "8080"; }

default_profile_source() {
  if [ -n "$(spoof_get '.default_profile' '')" ]; then
    echo "config/device-spoof.json"
  elif [ -n "$(cfg_get '.default_device_profile' '')" ]; then
    echo "config/defaults.json"
  else
    echo "built-in fallback"
  fi
}

# ── One-time migration: import legacy builds/ → instances/ ────────────────────
migrate_legacy_builds() {
  local stamp="${ROOT}/instances/.migrated"
  [ -f "$stamp" ] && return 0
  mkdir -p "${ROOT}/instances"
  local migrated=0
  shopt -s nullglob
  for link in "${ROOT}"/builds/android11-*-latest.qcow2; do
    [ -L "$link" ] || [ -f "$link" ] || continue
    local pname distro
    pname=$(basename "$link" | sed 's/android11-//;s/-latest\.qcow2//')
    distro=$(cat "${ROOT}/builds/android11-${pname}.distro" 2>/dev/null || echo "bliss14")
    instance_exists "$pname" && continue
    instance_create "$pname" "$pname" "$(default_vm_profile)" "$distro" >/dev/null 2>&1 || {
      # device profile may not exist by same name — fall back to generic
      instance_create "$pname" "generic" "$(default_vm_profile)" "$distro" >/dev/null 2>&1 || continue
    }
    # Move the disk into the instance dir (rename of the dated file, redirect symlink)
    local real_path
    real_path=$(readlink -f "$link" 2>/dev/null || echo "$link")
    if [ -f "$real_path" ]; then
      mv "$real_path" "$(instance_disk "$pname")"
      rm -f "$link"
    fi
    migrated=$(( migrated + 1 ))
  done
  shopt -u nullglob
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) migrated=${migrated}" > "$stamp"
  [ "$migrated" -gt 0 ] && log "Migrated ${migrated} legacy build(s) to instances/"
}

# Resolve a positional "name" into an instance name. If the name does not yet
# exist as an instance but a legacy build does (or a same-named device profile
# does), auto-create an instance bound to it. Echoes the instance name.
resolve_or_create_instance() {
  local name="$1"
  if instance_exists "$name"; then echo "$name"; return; fi

  local legacy_img="${ROOT}/builds/android11-${name}-latest.qcow2"
  local distro
  distro=$(cat "${ROOT}/builds/android11-${name}.distro" 2>/dev/null || echo "$(default_distro)")
  local device_profile="$name"
  [ -f "${ROOT}/profiles/${device_profile}.json" ] || device_profile="generic"

  instance_create "$name" "$device_profile" "$(default_vm_profile)" "$distro" >/dev/null \
    || die "Could not auto-create instance '${name}'. Provide a valid name or use 'android-vm instance create'."

  if [ -L "$legacy_img" ] || [ -f "$legacy_img" ]; then
    local real_path
    real_path=$(readlink -f "$legacy_img" 2>/dev/null || echo "$legacy_img")
    [ -f "$real_path" ] && mv "$real_path" "$(instance_disk "$name")"
    rm -f "$legacy_img"
  fi
  echo "$name"
}

# ── Usage ─────────────────────────────────────────────────────────────────────
usage() {
  cat <<'USAGE'
android-vm — Android x86 VM manager

SUBCOMMANDS
  start [instance] [--vm-profile <name>]
      Start the VM. If no instance is given, uses the default device profile.

  stop  [instance]
  status [instance]
  reset [instance]      Reformat the Userdata partition (factory reset).

  instance create <name> --profile <dev> --vm-profile <hw> --distro <d>
  instance list [--json]
  instance start <name>
  instance stop <name>
  instance restart <name>
  instance reset <name>
  instance expand <name> <size> [--apply]
      Grow the Userdata partition (sda3). <size> is +<n>{M,G} (delta) or
      <n>{M,G} (absolute). Dry-run by default — pass --apply to perform.
  instance delete <name>
  instance show <name>

  gui [--port 8080] [--bind 127.0.0.1] [--no-open]
      Launch the Flask web UI (manage instances from the browser).

  update     git pull + refresh intermediate images from GitHub Releases.
  doctor     Check dependencies, KVM, images, disk space, RAM.
  profiles   List device profiles, VM hardware profiles, libvirt XML files.
  virt-manager [device-profile] [...]   Generate libvirt domain XML.

FLAGS (global)
  --debug    Enable bash -x trace mode
  -h, --help Show this help
USAGE
}

# ── cmd_start (legacy + auto-instance) ────────────────────────────────────────
cmd_start() {
  local name="" vm_profile="" explicit=false
  local extra_flags=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vm-profile) vm_profile="$2"; shift 2 ;;
      --debug)      shift ;;
      --spice|--headless|--no-kvm|--snapshot) extra_flags+=("$1"); shift ;;
      --vnc)
        extra_flags+=("$1")
        if [[ $# -gt 1 && "$2" =~ ^[0-9]+$ ]]; then
          extra_flags+=("$2"); shift 2
        else
          shift
        fi
        ;;
      -*) die "Unknown flag for start: $1" ;;
      *)  name="$1"; explicit=true; shift ;;
    esac
  done

  [ -z "$name" ] && name=$(default_device_profile)
  $explicit || log "No instance specified — using default '${name}' (source: $(default_profile_source))"

  migrate_legacy_builds
  name=$(resolve_or_create_instance "$name")

  if instance_running "$name"; then
    warn "Instance '${name}' is already running (PID $(cat "$(instance_pid_file "$name")"))"
    warn "Use 'android-vm stop ${name}' first"
    exit 1
  fi

  local disk
  disk=$(instance_disk "$name")
  if [ ! -f "$disk" ]; then
    die "No disk for instance '${name}'.
    Build it with: android-vm instance reset ${name}  (after creating it)
    Or run: bash scripts/set-profile.sh ${name}"
  fi

  log "Starting instance: ${name}"
  local boot_args=("$name")
  [ -n "$vm_profile" ] && boot_args+=(--vm-profile "$vm_profile")
  boot_args+=("${extra_flags[@]}")
  bash "${ROOT}/scripts/boot.sh" "${boot_args[@]}"
}

# ── cmd_stop ──────────────────────────────────────────────────────────────────
cmd_stop() {
  local name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --debug) shift ;;
      -*) die "Unknown flag for stop: $1" ;;
      *)  name="$1"; shift ;;
    esac
  done
  [ -z "$name" ] && name=$(default_device_profile)
  migrate_legacy_builds

  local pid_file
  pid_file=$(instance_pid_file "$name")
  if [ ! -f "$pid_file" ]; then
    warn "No PID file for '${name}' — VM may not be running"
    exit 1
  fi

  local pid
  pid=$(cat "$pid_file")

  if kill -0 "$pid" 2>/dev/null; then
    log "Stopping '${name}' (PID ${pid})..."
    kill "$pid"
    local n=0
    while kill -0 "$pid" 2>/dev/null && [ "$n" -lt 10 ]; do
      sleep 1; n=$(( n + 1 ))
    done
    if kill -0 "$pid" 2>/dev/null; then
      warn "VM did not stop cleanly — sending SIGKILL"
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$pid_file" "$(instance_qmp_sock "$name")"
    ok "VM stopped"
  else
    warn "PID ${pid} is not running — removing stale PID file"
    rm -f "$pid_file"
  fi
}

# ── cmd_reset ─────────────────────────────────────────────────────────────────
cmd_reset() {
  local name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --debug) shift ;;
      -*) die "Unknown flag for reset: $1" ;;
      *)  name="$1"; shift ;;
    esac
  done
  [ -z "$name" ] && name=$(default_device_profile)
  migrate_legacy_builds

  if instance_running "$name"; then
    log "Instance appears to be running — stopping first"
    cmd_stop "$name"
  fi

  local img
  if instance_exists "$name"; then
    img=$(instance_disk "$name")
  else
    img="${ROOT}/builds/android11-${name}-latest.qcow2"
  fi
  [ -f "$img" ] || die "No disk for '${name}': ${img}"

  log "Reformatting Userdata partition (sda3) in $(basename "$img") ..."
  local nbd
  nbd=$(alloc_nbd) || die "Could not allocate NBD device"
  log "Using ${nbd}"
  sudo qemu-nbd --connect="$nbd" "$img"
  sleep 1
  local mkfs_rc=0
  sudo mkfs.ext4 -F -L Userdata "${nbd}p3" || mkfs_rc=$?
  release_nbd "$nbd"
  [ "$mkfs_rc" -eq 0 ] || die "mkfs.ext4 failed (exit ${mkfs_rc}) — userdata not reset"
  ok "Userdata reset for '${name}' (sda3 reformatted as ext4)"
}

# ── cmd_expand ────────────────────────────────────────────────────────────────
#
# Resolve a size argument against a current byte size.
#   +<n>{M,G}  → cur + n*unit
#   <n>{M,G}   → n*unit  (absolute)
# Echoes the resolved size in bytes.
resolve_size() {
  local cur="$1" arg="$2"
  local rel=false
  if [[ "$arg" == +* ]]; then rel=true; arg="${arg#+}"; fi
  local num="${arg%[MmGg]}" suf="${arg: -1}" unit
  case "$suf" in
    M|m) unit=$((1024*1024)) ;;
    G|g) unit=$((1024*1024*1024)) ;;
    *)   echo "resolve_size: bad unit in '$arg' (use M or G)" >&2; return 1 ;;
  esac
  [[ "$num" =~ ^[0-9]+$ ]] || { echo "resolve_size: bad number in '$arg'" >&2; return 1; }
  local bytes=$(( num * unit ))
  if $rel; then bytes=$(( cur + bytes )); fi
  echo "$bytes"
}

# Format bytes as a human-readable size for logs.
human_size() {
  local b="$1"
  awk -v b="$b" 'BEGIN {
    if (b >= 1073741824) printf "%.1f GiB", b/1073741824;
    else if (b >= 1048576) printf "%.1f MiB", b/1048576;
    else printf "%d B", b;
  }'
}

cmd_expand() {
  local name="" size_arg="" apply=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply) apply=true; shift ;;
      --debug) shift ;;
      -*) die "Unknown flag for expand: $1" ;;
      *)
        if   [ -z "$name" ];     then name="$1"
        elif [ -z "$size_arg" ]; then size_arg="$1"
        else die "Unexpected argument: $1"
        fi
        shift
        ;;
    esac
  done
  [ -n "$name" ]     || die "Usage: android-vm instance expand <name> <size> [--apply]"
  [ -n "$size_arg" ] || die "Size required (e.g. +4G, 16G, 8192M)"

  migrate_legacy_builds
  instance_exists "$name" || die "No such instance: ${name}"
  if instance_running "$name"; then
    die "Instance '${name}' is running — stop it first: android-vm stop ${name}"
  fi

  local img cur_bytes new_bytes info fmt
  img=$(instance_disk "$name")
  [ -f "$img" ] || die "No disk for '${name}': ${img}"

  # Single info call gives us both the virtual size and the on-disk format.
  # Instance disks are qcow2 overlays over the distro intermediate; resizing
  # the overlay grows only its virtual size and never touches the backing
  # file. Passing the format explicitly avoids qemu's format-probing path.
  info=$(qemu-img info --output=json "$img") || die "Cannot read image info: ${img}"
  cur_bytes=$(jq -r '."virtual-size"' <<<"$info")
  fmt=$(jq -r '.format // "qcow2"' <<<"$info")
  [ "$fmt" = "null" ] && fmt="qcow2"

  new_bytes=$(resolve_size "$cur_bytes" "$size_arg") || die "Bad size: $size_arg"

  if [ "$new_bytes" -le "$cur_bytes" ]; then
    die "Refusing to shrink: current $(human_size "$cur_bytes") → requested $(human_size "$new_bytes") (would lose data)"
  fi

  local delta=$(( new_bytes - cur_bytes ))
  log "Plan: ${fmt} ${img}"
  log "      $(human_size "$cur_bytes") → $(human_size "$new_bytes") (+$(human_size "$delta") added to Userdata)"

  if ! $apply; then
    log "Dry-run only. Re-run with --apply to perform the expansion."
    return 0
  fi

  log "Resizing ${fmt} image ..."
  qemu-img resize -f "$fmt" "$img" "$new_bytes" || die "qemu-img resize failed"

  local nbd
  nbd=$(alloc_nbd) || die "Could not allocate NBD device"
  log "Using ${nbd}"
  sudo qemu-nbd --connect="$nbd" --format="$fmt" "$img" \
    || { release_nbd "$nbd"; die "qemu-nbd could not attach ${img}"; }
  sleep 1

  local fail=0 part="${nbd}p3"
  log "Fixing GPT and growing p3 (Userdata) to fill new space ..."
  sudo parted -s "$nbd" --fix -- resizepart 3 100% || fail=$?

  # Wait for the kernel to expose the (resized) p3 node before touching its
  # filesystem — partition rescans aren't always instantaneous, and acting
  # too early yields a confusing "No such file" from e2fsck.
  if [ "$fail" -eq 0 ]; then
    local tries=0
    until [ -b "$part" ] || [ "$tries" -ge 20 ]; do
      sudo partprobe "$nbd" 2>/dev/null || true
      sleep 0.5; tries=$((tries + 1))
    done
    [ -b "$part" ] || { fail=1; warn "Partition node ${part} never appeared"; }
  fi

  if [ "$fail" -eq 0 ]; then
    log "fsck p3 (pre) ..."
    sudo e2fsck -fy "$part" || fail=$?
  fi
  if [ "$fail" -eq 0 ]; then
    log "resize2fs p3 ..."
    sudo resize2fs "$part" || fail=$?
  fi
  if [ "$fail" -eq 0 ]; then
    log "fsck p3 (post) ..."
    sudo e2fsck -fy "$part" || fail=$?
  fi
  release_nbd "$nbd"

  [ "$fail" -eq 0 ] || die "Expansion failed (exit ${fail}) — image was resized but partition/fs may need manual repair"
  ok "Expanded '${name}' to $(human_size "$new_bytes") (Userdata grew by $(human_size "$delta"))"
}

# ── cmd_update ────────────────────────────────────────────────────────────────
cmd_update() {
  log "Pulling latest changes..."
  if ! git -C "$ROOT" pull --ff-only; then
    warn "git pull failed — the repo may be in a detached HEAD state"
    warn "Run: git -C ${ROOT} fetch origin && git -C ${ROOT} checkout main && git -C ${ROOT} pull"
    exit 1
  fi
  ok "Repo updated"

  local fetch_script="${ROOT}/scripts/lib/fetch-release.sh"
  if [ -f "$fetch_script" ]; then
    local remote_url owner_repo=""
    remote_url=$(git -C "$ROOT" remote get-url origin 2>/dev/null || echo "")
    if echo "$remote_url" | grep -q "github.com"; then
      owner_repo=$(echo "$remote_url" \
        | sed 's|.*github\.com[:/]\(.*\)\.git$|\1|; s|.*github\.com[:/]\(.*\)|\1|')
    fi
    if [ -n "$owner_repo" ]; then
      local updated=0
      for distro_cfg in "${ROOT}"/androiddistro/*.json; do
        [ -f "$distro_cfg" ] || continue
        local slug base_image
        slug=$(       jq -r '.slug'       "$distro_cfg" 2>/dev/null) || continue
        base_image=$( jq -r '.base_image' "$distro_cfg" 2>/dev/null) || continue
        log "Checking for updated intermediate: ${slug} (${base_image})..."
        ROOT="${ROOT}" bash "$fetch_script" \
          "$owner_repo" "${base_image}*" "${ROOT}/intermediate/" \
          --tag-prefix "${slug}-base-" \
          && updated=$(( updated + 1 )) \
          || warn "No GitHub Release found for '${slug}' — build locally: bash scripts/lib/fetch-distro.sh ${slug}"
      done
      ok "${updated} distro image(s) checked/updated"
    else
      warn "Cannot determine GitHub repo from remote URL — skipping image update"
    fi
  else
    warn "fetch-release.sh not available — skipping image update"
  fi
}

# ── cmd_doctor ────────────────────────────────────────────────────────────────
cmd_doctor() {
  local fail=0

  check_ok()   { printf "  ${GRN}✓${NC} %s\n" "$*"; }
  check_fail() { printf "  ${RED}✗${NC} %s\n" "$*"; fail=$(( fail + 1 )); }
  check_warn() { printf "  ${YEL}!${NC} %s\n" "$*"; }

  local hw_script="${ROOT}/scripts/lib/detect-hardware.sh"
  # shellcheck source=scripts/lib/detect-hardware.sh
  [ -f "$hw_script" ] && . "$hw_script"

  printf "\n${DIM}━━━ Dependencies ━━━${NC}\n"
  for bin in qemu-system-x86_64 qemu-img qemu-nbd adb jq python3 git curl; do
    if command -v "$bin" &>/dev/null; then
      check_ok "${bin}  ($(command -v "$bin"))"
    else
      check_fail "${bin} not found"
    fi
  done

  printf "\n${DIM}━━━ KVM / Virtualisation ━━━${NC}\n"
  if grep -qE 'vmx|svm' /proc/cpuinfo; then
    local vendor="unknown"
    command -v detect_cpu_vendor &>/dev/null && vendor=$(detect_cpu_vendor)
    check_ok "CPU virtualisation extensions (${vendor})"
  else
    check_warn "No vmx/svm in /proc/cpuinfo — KVM unavailable, TCG fallback only"
  fi

  if [ -e /dev/kvm ]; then
    check_ok "/dev/kvm available"
    if groups 2>/dev/null | grep -q '\bkvm\b' || [ "${USER:-root}" = "root" ]; then
      check_ok "KVM group access confirmed"
    else
      check_warn "User not in 'kvm' group — run: sudo usermod -aG kvm \$USER  then re-login"
    fi
  else
    check_fail "/dev/kvm missing — load module: sudo modprobe kvm_intel  or  kvm_amd"
  fi

  printf "\n${DIM}━━━ Images ━━━${NC}\n"
  local found_intermediates=0
  for distro_cfg in "${ROOT}"/androiddistro/*.json; do
    [ -f "$distro_cfg" ] || continue
    local slug base_image intermediate
    slug=$(      jq -r '.slug'       "$distro_cfg" 2>/dev/null) || continue
    base_image=$(jq -r '.base_image' "$distro_cfg" 2>/dev/null) || continue
    intermediate="${ROOT}/intermediate/${base_image}"
    if [ -f "$intermediate" ]; then
      local sz
      sz=$(du -sh "$intermediate" 2>/dev/null | cut -f1)
      check_ok "Intermediate: ${slug}  (${sz})"
      found_intermediates=$(( found_intermediates + 1 ))
    else
      check_fail "Intermediate missing: ${slug} (${base_image})"
      check_warn "Download with: android-vm update  or  bash install.sh"
    fi
  done
  [ "$found_intermediates" -eq 0 ] && check_warn "No intermediates found — run: android-vm update"

  local found_instances=0
  shopt -s nullglob
  for f in "${ROOT}"/instances/*.json; do
    local iname
    iname=$(basename "$f" .json)
    check_ok "Instance: ${iname}"
    found_instances=$(( found_instances + 1 ))
  done
  shopt -u nullglob
  [ "$found_instances" -eq 0 ] && check_warn "No instances configured — create with: android-vm instance create <name> ..."

  printf "\n${DIM}━━━ Config ━━━${NC}\n"
  [ -f "$DEFAULTS_JSON" ] && check_ok "config/defaults.json"      || check_warn "config/defaults.json missing — using built-in defaults"
  [ -f "$SPOOF_JSON"    ] && check_ok "config/device-spoof.json"  || check_warn "config/device-spoof.json missing — using built-in defaults"
  local vp_count
  vp_count=$(find "${ROOT}/config/vm-profiles" -name '*.json' 2>/dev/null | wc -l)
  if [ "$vp_count" -ge 4 ]; then
    check_ok "VM profiles: ${vp_count} found"
  else
    check_warn "VM profiles: only ${vp_count} found (expected 4)"
  fi
  check_ok "Default device profile: $(default_device_profile)  (source: $(default_profile_source))"

  printf "\n${DIM}━━━ Disk Space ━━━${NC}\n"
  local avail_gb
  avail_gb=$(df --output=avail -BG "${ROOT}" 2>/dev/null | tail -1 | tr -d 'G ' || echo "0")
  if [ "${avail_gb:-0}" -ge 25 ]; then
    check_ok "Disk space: ${avail_gb} GB available"
  elif [ "${avail_gb:-0}" -ge 10 ]; then
    check_warn "Disk space: ${avail_gb} GB — may be tight for building"
  else
    check_fail "Disk space: ${avail_gb} GB — need at least 10 GB"
  fi

  printf "\n${DIM}━━━ RAM ━━━${NC}\n"
  if command -v detect_ram_mb &>/dev/null; then
    local total_mb total_gb recommended
    total_mb=$(detect_ram_mb)
    total_gb=$(( total_mb / 1024 ))
    if   [ "$total_gb" -ge 8 ]; then recommended="performance"
    elif [ "$total_gb" -ge 6 ]; then recommended="balanced"
    elif [ "$total_gb" -ge 4 ]; then recommended="balanced"
    else                              recommended="lowram or compatibility"; fi
    check_ok "RAM: ${total_gb} GB total — recommended vm-profile: ${recommended}"
  else
    check_warn "detect-hardware.sh not available — cannot assess RAM"
  fi

  printf "\n"
  if [ "$fail" -eq 0 ]; then
    printf "${GRN}All checks passed.${NC}\n\n"
  else
    printf "${RED}${fail} check(s) failed — fix issues above before running the VM.${NC}\n\n"
    exit 1
  fi
}

# ── cmd_profiles ──────────────────────────────────────────────────────────────
cmd_profiles() {
  local default_dev default_vm
  default_dev=$(default_device_profile)
  default_vm=$(default_vm_profile)

  printf "\n${DIM}━━━ Device Profiles (identity) ━━━${NC}\n"
  for f in "${ROOT}"/profiles/*.json; do
    [ "$(basename "$f")" = "schema.json" ] && continue
    [ -f "$f" ] || continue
    local id desc default_mark=""
    id=$(jq -r '.meta.id // "?"' "$f" 2>/dev/null)
    desc=$(jq -r '.meta.description // ""' "$f" 2>/dev/null)
    [ "$id" = "$default_dev" ] && default_mark=" ${YEL}(default)${NC}"
    printf "  ${BLU}%-22s${NC} %s%b\n" "$id" "$desc" "$default_mark"
  done

  printf "\n${DIM}━━━ VM Hardware Profiles ━━━${NC}\n"
  for f in "${ROOT}"/config/vm-profiles/*.json; do
    [ -f "$f" ] || continue
    local name desc ram cores threads
    name=$(basename "$f" .json)
    desc=$(jq -r '.description' "$f" 2>/dev/null)
    ram=$(jq -r '.ram_mb' "$f" 2>/dev/null)
    cores=$(jq -r '.cpu_cores' "$f" 2>/dev/null)
    threads=$(jq -r '.cpu_threads' "$f" 2>/dev/null)
    local marker=""
    [ "$name" = "$default_vm" ] && marker=" ${YEL}(default)${NC}"
    printf "  ${BLU}%-16s${NC} %sMB  %sc/%st  %s%b\n" \
      "$name" "$ram" "$cores" "$threads" "$desc" "$marker"
  done

  printf "\n${DIM}━━━ Distros ━━━${NC}\n"
  for f in "${ROOT}"/androiddistro/*.json; do
    [ -f "$f" ] || continue
    local slug
    slug=$(jq -r '.slug // (.name|ascii_downcase|gsub(" "; "-"))' "$f" 2>/dev/null)
    printf "  ${BLU}%s${NC}\n" "$slug"
  done
  printf "\n"
}

# ── cmd_virt_manager ─────────────────────────────────────────────────────────
cmd_virt_manager() {
  local device_profile vm_profile define=false start_vm=false output_path=""
  device_profile=$(default_device_profile)
  vm_profile=$(default_vm_profile)

  local gen_flags=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vm-profile) vm_profile="$2";   shift 2 ;;
      --define)     define=true;       shift   ;;
      --start)      start_vm=true;     shift   ;;
      --output)     output_path="$2";  gen_flags+=("$1" "$2"); shift 2 ;;
      --debug)      shift ;;
      --ram|--cores|--threads|--gpu|--audio|--adb-port)
        gen_flags+=("$1" "$2"); shift 2 ;;
      --no-spice)   gen_flags+=("$1"); shift ;;
      -*) die "Unknown flag for virt-manager: $1" ;;
      *)  device_profile="$1"; shift ;;
    esac
  done

  [ -z "$output_path" ] && output_path="${ROOT}/run/${device_profile}.xml"

  bash "${ROOT}/scripts/gen-libvirt-xml.sh" \
    "$device_profile" \
    --vm-profile "$vm_profile" \
    "${gen_flags[@]}"

  if $define; then
    if command -v virsh &>/dev/null; then
      log "Defining domain with virsh..."
      virsh define "$output_path"
      ok "Domain defined: android-${device_profile}"
    else
      warn "virsh not found — install libvirt-clients to use --define"
      warn "Manual: virsh define ${output_path}"
    fi
  fi

  if $start_vm; then
    if ! $define; then
      warn "--start requires --define (or a pre-existing domain)"
    elif command -v virsh &>/dev/null; then
      log "Starting domain..."
      virsh start "android-${device_profile}"
      ok "Domain started: android-${device_profile}"
    else
      warn "virsh not found — cannot start domain"
    fi
  fi

  if ! $define && ! $start_vm; then
    printf "\n"
    log "XML written to: ${output_path}"
    log "Import: virsh define ${output_path}  &&  virsh start android-${device_profile}"
    printf "\n"
  fi
}

# ── cmd_status ────────────────────────────────────────────────────────────────
cmd_status() {
  local target="${1:-}"
  migrate_legacy_builds

  printf "\n${DIM}━━━ Instance Status ━━━${NC}\n"

  local list
  list=$(instance_list_json)
  local count
  count=$(echo "$list" | jq 'length')
  if [ "$count" -eq 0 ]; then
    log "No instances configured. Create one with:"
    log "  android-vm instance create <name> --profile <dev> --vm-profile <hw> --distro <d>"
    printf "\n"
    return
  fi

  local i=0
  while [ "$i" -lt "$count" ]; do
    local name state pid adb_port spice_port distro vmp
    name=$(echo "$list" | jq -r ".[${i}].name")
    if [ -n "$target" ] && [ "$name" != "$target" ]; then
      i=$(( i + 1 )); continue
    fi
    state=$(echo "$list"      | jq -r ".[${i}].state")
    pid=$(echo "$list"        | jq -r ".[${i}].pid")
    adb_port=$(echo "$list"   | jq -r ".[${i}].adb_port")
    spice_port=$(echo "$list" | jq -r ".[${i}].spice_port")
    distro=$(echo "$list"     | jq -r ".[${i}].distro")
    vmp=$(echo "$list"        | jq -r ".[${i}].vm_profile")

    local state_color
    case "$state" in
      running) state_color="${GRN}running${NC}" ;;
      stopped) state_color="${DIM}stopped${NC}" ;;
      *)       state_color="${YEL}${state}${NC}" ;;
    esac

    printf "  ${BLU}%-22s${NC} %b  ${DIM}%s/%s${NC}\n" "$name" "$state_color" "$distro" "$vmp"
    if [ "$state" = "running" ]; then
      printf "    PID %s   ADB: adb connect localhost:%s   SPICE: %s\n" \
        "$pid" "$adb_port" "$spice_port"
    else
      printf "    ${DIM}adb:%s   spice:%s${NC}\n" "$adb_port" "$spice_port"
    fi
    i=$(( i + 1 ))
  done
  printf "\n"
}

# ── cmd_instance ──────────────────────────────────────────────────────────────
cmd_instance() {
  local sub="${1:-list}"
  shift || true
  case "$sub" in
    list)    inst_list    "$@" ;;
    create)  inst_create  "$@" ;;
    delete)  inst_delete  "$@" ;;
    show)    inst_show    "$@" ;;
    start)   cmd_start    "$@" ;;
    stop)    cmd_stop     "$@" ;;
    restart) inst_restart "$@" ;;
    reset)   cmd_reset    "$@" ;;
    expand)  cmd_expand   "$@" ;;
    *) die "Unknown instance subcommand: '${sub}'. Try: list, create, start, stop, restart, reset, expand, delete, show" ;;
  esac
}

inst_list() {
  local json=false
  for arg in "$@"; do [ "$arg" = "--json" ] && json=true; done
  migrate_legacy_builds
  if $json; then
    instance_list_json
  else
    cmd_status
  fi
}

inst_create() {
  local name="" device_profile="" vm_profile="" distro=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)    device_profile="$2"; shift 2 ;;
      --vm-profile) vm_profile="$2";     shift 2 ;;
      --distro)     distro="$2";         shift 2 ;;
      -*) die "Unknown flag for instance create: $1" ;;
      *)  name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "Instance name required: android-vm instance create <name> --profile <dev> --vm-profile <hw> --distro <d>"
  [ -n "$device_profile" ] || device_profile=$(default_device_profile)
  [ -n "$vm_profile" ]     || vm_profile=$(default_vm_profile)
  [ -n "$distro" ]         || distro=$(default_distro)

  migrate_legacy_builds
  instance_create "$name" "$device_profile" "$vm_profile" "$distro" \
    || die "Failed to create instance '${name}'"
  ok "Instance created: ${name}"
  log "Next: build the disk with:  bash scripts/set-profile.sh ${name}"
  log "Then: start it with:        android-vm instance start ${name}"
}

inst_delete() {
  local name="${1:?instance name required}"
  instance_exists "$name" || die "No such instance: ${name}"
  if instance_running "$name"; then
    log "Instance is running — stopping first"
    cmd_stop "$name"
  fi
  instance_delete "$name"
  ok "Instance deleted: ${name}"
}

inst_show() {
  local name="${1:?instance name required}"
  instance_exists "$name" || die "No such instance: ${name}"
  jq . "$(instance_path "$name")"
}

inst_restart() {
  local name="${1:?instance name required}"
  cmd_stop  "$name" 2>/dev/null || true
  cmd_start "$name"
}

# ── cmd_gui ───────────────────────────────────────────────────────────────────
cmd_gui() {
  local port bind="127.0.0.1" open=true
  port=$(default_gui_port)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port)    port="$2"; shift 2 ;;
      --bind)    bind="$2"; shift 2 ;;
      --no-open) open=false; shift  ;;
      --debug)   shift ;;
      *) die "Unknown flag for gui: $1" ;;
    esac
  done
  command -v python3 &>/dev/null || die "python3 is required for the GUI"
  python3 -c "import flask" 2>/dev/null \
    || die "Flask is not installed. Install with: pip3 install --user flask"

  local url="http://${bind}:${port}/"
  log "Starting Flask GUI on ${url}"
  if $open && command -v xdg-open &>/dev/null; then
    ( sleep 1; xdg-open "$url" >/dev/null 2>&1 || true ) &
  fi
  ANDROID_VM_ROOT="$ROOT" exec python3 "${ROOT}/gui/app.py" --host "$bind" --port "$port"
}

CMD="${1:-help}"
shift || true

case "$CMD" in
  start)        cmd_start        "$@" ;;
  stop)         cmd_stop         "$@" ;;
  status)       cmd_status       "$@" ;;
  reset)        cmd_reset        "$@" ;;
  update)       cmd_update       "$@" ;;
  doctor)       cmd_doctor       "$@" ;;
  profiles)     cmd_profiles     "$@" ;;
  virt-manager) cmd_virt_manager "$@" ;;
  instance)     cmd_instance     "$@" ;;
  gui)          cmd_gui          "$@" ;;
  help|-h|--help) usage; exit 0 ;;
  --debug)  echo "Pass --debug after the subcommand, e.g.: android-vm start --debug"; exit 1 ;;
  *) die "Unknown subcommand: '${CMD}'. Run 'android-vm help' for usage." ;;
esac
